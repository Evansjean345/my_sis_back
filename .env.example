 cat .env
# =============================================================================
#  SISBM CORE — variables d'environnement
#  NE JAMAIS COMMITER CE FICHIER
# =============================================================================
#
#  PORTS — plage réservée à SISBM
#  Ta machine héberge déjà un PostgreSQL natif Windows (postgres.exe, service
#  permanent) sur 5432, plus la pile « aiglesend » sur 3307/5433/5434/6377/6378
#  et 3333. Tous les ports ci-dessous sont choisis hors de ces plages.
#
#      PostgreSQL   5435      (natif Windows : 5432 · aiglesend : 5433, 5434)
#      Redis        6380      (aiglesend : 6377, 6378)
#      MQTT         1883      (libre)
#      API          3336      (aiglesend-dev-api : 3333)
#
# =============================================================================

TZ=
PORT=
HOST=
LOG_LEVEL=
APP_KEY=
NODE_ENV=

# --------------------------------------------------------------- base de données
DB_CONNECTION=
DB_HOST=
DB_PORT=
DB_DATABASE=
# Migrations : sisbm_owner  |  Runtime applicatif : sisbm_app
DB_USER=
DB_PASSWORD=
DB_SSL=
DB_POOL_MIN=
DB_POOL_MAX=

# --------------------------------------------------------------- redis
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# --------------------------------------------------------------- flespi (REST)
# Jeton REST (administration : canaux, devices, commandes). JAMAIS commité.
FLESPI_TOKEN=
FLESPI_BASE_URL=
FLESPI_TIMEOUT_MS=
# Canal micodus de la flotte (POST /api/v1/flespi/channels), ex. 1442013
FLESPI_CHANNEL_ID=
FLESPI_PROTOCOL_NAME=
# Type de boîtier : id numérique, name ou title flespi — résolu dans le protocole du canal
#FLESPI_DEVICE_TYPE=Micodus MV730
FLESPI_DEVICE_TYPE=
FLESPI_DEVICE_MESSAGES_TTL=
# Commandes mises en file
FLESPI_COMMAND_TTL_SECONDS=
FLESPI_COMMAND_MAX_ATTEMPTS=
FLESPI_WEBHOOK_SECRET=


# --------------------------------------------------------------- flespi (MQTT)
# Broker MQTT flespi — username = jeton, mot de passe vide
FLESPI_MQTT_HOST=
FLESPI_MQTT_PORT=
FLESPI_MQTT_TLS=
# Jeton DÉDIÉ au worker, limité par ACL à flespi/message/gw/devices/# (défaut : FLESPI_TOKEN)
FLESPI_MQTT_TOKEN=
# clientId STABLE : la session persistante (messages retenus pendant un arrêt) y est attachée
FLESPI_MQTT_CLIENT_ID=
FLESPI_MQTT_TOPICS=
# Renseigner pour plusieurs workers (souscription partagée $share/<groupe>/...)
FLESPI_MQTT_SHARE_GROUP=
FLESPI_MQTT_SESSION_EXPIRY=

# --------------------------------------------------------------- client MQTT (réglages)
MQTT_RECONNECT_PERIOD_MS=
MQTT_CONNECT_TIMEOUT_MS=
MQTT_MAX_INFLIGHT=

MQTT_HOST=
MQTT_PORT=
MQTT_TLS=   # true en production
MQTT_PROTOCOL_VERSION=
MQTT_CLIENT_ID=
MQTT_USERNAME=
#MQTT_PASSWORD=Ing3st_S1sbm#2026
#MQTT_MONITOR_PASSWORD=M0n1t_S1sbm#2026
MQTT_TOPIC_TELEMETRY=
MQTT_TOPIC_EVENTS=
MQTT_MESSAGE_EXPIRY_SECONDS=# TTL : au-delà, la position est périmée
MQTT_QOS=             # « au moins une fois » — le dédoublonnage
MQTT_MONITOR_PASSWORD=

# --------------------------------------------------------------- ingestion
# Filtres qualité appliqués à chaque position (cf. gouvernance §e)
INGEST_MAX_HDOP=
INGEST_MIN_SATELLITES=
INGEST_MAX_PLAUSIBLE_SPEED_KPH=
# Au-delà de ce décalage recorded_at/received_at, la trame est traitée
# en rattrapage Store & Forward et exclue du flux temps réel.
INGEST_BACKLOG_THRESHOLD_SECONDS=

# Rafales : trames traitées simultanément (sérialisé par boîtier, parallèle
# entre boîtiers). Au-delà de DB_POOL_MAX, les tâches attendraient une
# connexion — inutile de monter plus haut.
INGEST_CONCURRENCY=
# Profondeur de file avant contre-pression : le worker diffère alors ses
# acquittements et le broker retient la suite dans la session persistante.
INGEST_QUEUE_MAX=
# Borne la rafale d'un seul tracker, pour qu'il ne remplisse pas la file.
INGEST_QUEUE_MAX_PER_DEVICE=

# --------------------------------------------------------------- trajets
TRIP_IDLE_TIMEOUT_SECONDS=
TRIP_MAX_DURATION_HOURS=
TRIP_MIN_DISTANCE_M=

# --------------------------------------------------------------- sécurité / immobilisation
# CM-07 : aucune coupure moteur au-dessus de ce seuil
IMMOBILIZATION_SAFETY_SPEED_KPH=
IMMOBILIZATION_REQUIRE_VALIDATION=
IMMOBILIZATION_COMMAND_TTL_MINUTES=
#IMMOBILIZATION_MAX_POSITION_AGE_SECONDS=120
IMMOBILIZATION_MAX_POSITION_AGE_SECONDS=
IMMOBILIZATION_ENABLED=

# --------------------------------------------------------------- immobilisation planifiée
# Moteur : node ace sisbm:schedules:enforce --watch (UN seul process)
# IMMOBILIZATION_ENABLED reste l'interrupteur général des coupures.
SCHEDULE_ENFORCEMENT_ENABLED=
SCHEDULE_ENFORCE_INTERVAL_SECONDS=
SCHEDULE_ENFORCE_RETRY_SECONDS=
SCHEDULE_ENFORCE_BACKOFF_SECONDS=


# --------------------------------------------------------------- sms (twilio)
# log = SMS écrits dans la console (dev, interdit en production) | twilio
SMS_PROVIDER=
#brand est inutile le supprimer après
SMS_BRAND=
# Chaque SMS débite sms_balance (crédits plateforme) ; recharge : POST /api/v1/admin/sms/topup
SMS_ENFORCE_BALANCE=
# Indicatif ajouté aux numéros saisis au format national (0161899990 → +2250161899990)
SMS_DEFAULT_DIAL_CODE=

# SID du COMPTE (AC…) : il figure dans l'URL des requêtes
TWILIO_ACCOUNT_SID=
# Clé d'API (SK…) + secret : authentification Basic. JAMAIS commités.
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=
# Auth Token principal : requis uniquement pour vérifier la signature des webhooks
TWILIO_AUTH_TOKEN=
TWILIO_TIMEOUT_MS=
# Sender ID alphanumérique (11 car. max) — PRÉ-ENREGISTREMENT requis en Côte d'Ivoire
TWILIO_FROM=
# Prioritaire sur TWILIO_FROM s'il est renseigné
TWILIO_MESSAGING_SERVICE_SID=
# URL publique exacte du webhook d'accusés (vide = pas d'accusés de remise)
# ex. https://api.sisbm.ci/api/v1/webhooks/twilio/sms-status
TWILIO_STATUS_CALLBACK_URL=


# --------------------------------------------------------------- e-mail (brevo)
# log = e-mails écrits dans la console (dev, interdit en production) | brevo
MAIL_PROVIDER=
# Expéditeur VÉRIFIÉ dans Brevo (Senders & Domains), idéalement domaine authentifié SPF/DKIM
MAIL_FROM_EMAIL=
MAIL_FROM_NAME=
# Adresse de réponse (vide = aucune)
MAIL_REPLY_TO=
# Clé API v3 Brevo (xkeysib-…) — JAMAIS commitée
BREVO_API_KEY=
BREVO_TIMEOUT_MS=

# --------------------------------------------------------------- otp (mot de passe oublié)
OTP_LENGTH=
OTP_TTL_SECONDS=
OTP_MAX_ATTEMPTS=
OTP_RESEND_COOLDOWN_SECONDS=
OTP_MAX_PER_HOUR=

# --------------------------------------------------------------- outbox (sisbm:outbox:dispatch)
OUTBOX_POLL_INTERVAL_MS=
OUTBOX_BATCH_SIZE=
OUTBOX_MAX_ATTEMPTS=
OUTBOX_RETRY_BASE_SECONDS=
OUTBOX_STALE_LOCK_SECONDS=


# --------------------------------------------------------------- notifications
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=


SMS_API_URL=
SMS_API_KEY=
SMS_SENDER_ID=

WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=

# --------------------------------------------------------------- rétention
RETENTION_POSITIONS_MONTHS=
RETENTION_INGEST_MESSAGES_MONTHS=
RETENTION_REPORTS_DAYS=