diff --git a/.env.example b/.env.example
index 3ce0697..7f2b2dd 100644
--- a/.env.example
+++ b/.env.example
@@ -82,8 +82,17 @@ MQTT_TLS=false      # true en production
 MQTT_PROTOCOL_VERSION=5 
 MQTT_CLIENT_ID=sisbm-ingest
 MQTT_USERNAME=sisbm_ingest
-#MQTT_PASSWORD=Ing3st_S1sbm#2026
-#MQTT_MONITOR_PASSWORD=M0n1t_S1sbm#2026
+# GUILLEMETS OBLIGATOIRES : ces valeurs contiennent un `#`. Sans guillemets,
+# Docker Compose garde la valeur entière alors qu'AdonisJS la tronque au `#`
+# (vérifié : « M0n1t_S1sbm#2026 » devient « M0n1t_S1sbm »). Le broker et le
+# worker utiliseraient alors deux mots de passe différents, et
+# l'authentification MQTT échouerait sans raison apparente.
+#
+# MQTT_MONITOR_PASSWORD est EXIGÉ par docker-compose.yml (`:?`) : Compose
+# interpole tout le fichier, donc même `docker compose up postgres redis`
+# échoue si la variable manque.
+MQTT_PASSWORD="Ing3st_S1sbm#2026"
+MQTT_MONITOR_PASSWORD="M0n1t_S1sbm#2026"
 MQTT_TOPIC_TELEMETRY=sisbm/telemetry/+/data
 MQTT_TOPIC_EVENTS=sisbm/telemetry/+/events
 MQTT_MESSAGE_EXPIRY_SECONDS=300 # TTL : au-delà, la position est périmée
diff --git a/docker/docker-compose.yml b/docker/docker-compose.yml
index 09aea62..d7afa15 100644
--- a/docker/docker-compose.yml
+++ b/docker/docker-compose.yml
@@ -131,8 +131,12 @@ services:
       # `:ro` — le broker ne doit jamais réécrire sa propre configuration
       # ni son fichier de mots de passe.
       - ./mosquitto/mosquitto.conf:/mosquitto/config/mosquitto.conf:ro
-      - ./mosquitto/acl:/mosquitto/config/acl:ro
-      - ./mosquitto/passwd:/mosquitto/config/passwd:ro
+      # Chemins RÉELS du dépôt : les deux fichiers sont dans `mosquitto/config/`.
+      # Montés depuis `./mosquitto/acl` (inexistant), Docker crée un RÉPERTOIRE
+      # vide à la place et mosquitto refuse de démarrer — `allow_anonymous` est
+      # à false et il ne trouve aucun fichier de mots de passe.
+      - ./mosquitto/config/acl:/mosquitto/config/acl:ro
+      - ./mosquitto/config/passwd:/mosquitto/config/passwd:ro
       - mosquitto_data:/mosquitto/data
     healthcheck:
       # -E : se connecte puis quitte aussitôt. Vérifie que le broker RÉPOND,
